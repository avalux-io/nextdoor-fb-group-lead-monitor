# Nextdoor API Configuration
NEXTDOOR_CLIENT_ID=your_nextdoor_client_id
NEXTDOOR_CLIENT_SECRET=your_nextdoor_client_secret
NEXTDOOR_REDIRECT_URI=http://localhost:8000/callback/nextdoor
NEXTDOOR_WEBHOOK_SECRET=your_webhook_verification_secret

# Facebook API Configuration
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_ACCESS_TOKEN=your_long_lived_access_token
FACEBOOK_WEBHOOK_VERIFY_TOKEN=your_webhook_verification_token

# Geographic Configuration
BUSINESS_LATITUDE=39.7392
BUSINESS_LONGITUDE=-104.9903
DEFAULT_SERVICE_RADIUS_MILES=15

# Lead Scoring Configuration
MIN_LEAD_SCORE=60
URGENT_LEAD_THRESHOLD=80
MAX_LEADS_PER_HOUR=50

# Notification Configuration
WEBHOOK_URL=https://your-domain.com/webhook/leads
WEBHOOK_SECRET=your_outbound_webhook_secret
NOTIFY_EMAIL=alerts@yourbusiness.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Database Configuration (if using persistent storage)
DATABASE_URL=sqlite:///leads.db
# DATABASE_URL=postgresql://user:pass@localhost/leaddb

# Redis Configuration (for caching and rate limiting)
REDIS_URL=redis://localhost:6379/0

# Monitoring and Logging
LOG_LEVEL=INFO
SENTRY_DSN=your_sentry_dsn_for_error_tracking

# Development Settings
DEBUG=False
TEST_MODE=False
DRY_RUN=False